{
  "name": "amercharts",
  "version": "0.1.0",
  "description": "Modern React chart components with soft gradients, elegant tooltips, and copy-ready free examples.",
  "type": "module",
  "license": "MIT",
  "author": "Amercharts",
  "homepage": "https://amercharts.com",
  "repository": {
